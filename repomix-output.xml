package com.ondam.checkup.entity;

import com.ondam.global.common.BaseTimeEntity;
import jakarta.persistence.*;
import lombok.*;

import java.math.BigDecimal;
import java.time.LocalDate;

/**
 * 국가건강검진 결과 중 핵심 6개 지표만 저장.
 * (혈압, 공복혈당, 총콜레스테롤, HDL, LDL, 중성지방)
 */
@Entity
@Table(name = "health_checkup")
@Getter
@NoArgsConstructor(access = AccessLevel.PROTECTED)
public class HealthCheckup extends BaseTimeEntity {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(nullable = false)
    private Long userId;

    @Column(nullable = false)
    private LocalDate checkupDate;

    // 혈압 (mmHg) - 수축기/이완기, 정상 기준 120/80 미만
    private Integer systolicBp;
    private Integer diastolicBp;

    // 공복혈당 (mg/dL) - 정상 기준 100 미만
    @Column(precision = 6, scale = 2)
    private BigDecimal fastingGlucose;

    // 총콜레스테롤 (mg/dL) - 정상 기준 200 미만
    @Column(precision = 6, scale = 2)
    private BigDecimal totalCholesterol;

    // HDL콜레스테롤 (mg/dL) - 정상 기준 60 이상
    @Column(precision = 6, scale = 2)
    private BigDecimal hdlCholesterol;

    // LDL콜레스테롤 (mg/dL) - 정상 기준 130 미만
    @Column(precision = 6, scale = 2)
    private BigDecimal ldlCholesterol;

    // 중성지방 (mg/dL) - 정상 기준 150 미만
    @Column(precision = 6, scale = 2)
    private BigDecimal triglyceride;

    @Builder
    public HealthCheckup(Long userId, LocalDate checkupDate,
                         Integer systolicBp, Integer diastolicBp,
                         BigDecimal fastingGlucose, BigDecimal totalCholesterol,
                         BigDecimal hdlCholesterol, BigDecimal ldlCholesterol,
                         BigDecimal triglyceride) {
        this.userId = userId;
        this.checkupDate = checkupDate;
        this.systolicBp = systolicBp;
        this.diastolicBp = diastolicBp;
        this.fastingGlucose = fastingGlucose;
        this.totalCholesterol = totalCholesterol;
        this.hdlCholesterol = hdlCholesterol;
        this.ldlCholesterol = ldlCholesterol;
        this.triglyceride = triglyceride;
    }
}
</file>

